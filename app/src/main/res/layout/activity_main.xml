<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/google_bg_dark">

    <!-- Primary Fullscreen Antigravity WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never" />

    <!-- Offline Reconnection Screen Overlay -->
    <WebView
        android:id="@+id/offlineHudView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Draggable Material 3 Controls Pill -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQuickHud"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_pill_button"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:text="@string/controls_button_label"
        android:contentDescription="@string/controls_button_description"
        android:textColor="@color/google_text_primary"
        android:textSize="13sp"
        android:textStyle="normal"
        android:elevation="6dp"
        app:icon="@drawable/ic_tune"
        app:iconTint="@color/google_accent_blue"
        app:iconSize="18dp"
        app:iconPadding="8dp"
        app:backgroundTint="@null" />

</FrameLayout>
